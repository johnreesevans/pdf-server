{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"gunicorn app:app --bind 0.0.0.0:${PORT:-8080} --workers 2 --timeout 90\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}
